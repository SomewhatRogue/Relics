{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "VITE_ONLINE=1 npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": null,
  "regions": [
    "sfo1"
  ],
  "functions": {
    "api/room.ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
